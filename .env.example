# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Tài khoản admin đầu tiên, được tạo tự động khi chạy lần đầu (nếu bảng
# users đang rỗng). Đổi mật khẩu ngay sau khi đăng nhập lần đầu là tốt nhất.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Dùng để ký cookie phiên đăng nhập — một chuỗi ngẫu nhiên dài, giữ bí mật.
# Có thể tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Liên kết mở trò chuyện trực tiếp trên trang /lien-he. Để trống thì liên
# kết tương ứng sẽ không hiển thị (không dùng URL giả). Ví dụ Zalo:
# https://zalo.me/<số điện thoại quốc tế, không có dấu +>
NEXT_PUBLIC_ZALO_CONTACT_URL=
NEXT_PUBLIC_MESSENGER_CONTACT_URL=

# Địa chỉ gốc của website (không có "/" ở cuối), dùng để tạo link trong tin
# báo khách mới, ví dụ: https://ngocam.vn
SITE_URL=

# Báo khách mới qua Telegram. Hướng dẫn từng bước có trong trang quản trị:
# /admin/tai-khoan → "Báo khách mới qua Telegram". Để trống thì không gửi.
# TELEGRAM_CHAT_ID: một hoặc nhiều số, cách nhau bằng dấu phẩy.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
